# Copy values into apps/api/.env for local development.
# Do not put production secrets in this file.

DATABASE_URL="postgresql://beos:beos@localhost:5432/beos?schema=public"
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
FILE_STORAGE_PATH=./uploads
AUTH_ACCESS_SECRET=change-me-to-a-random-secret-with-at-least-32-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_INVITE_TTL_HOURS=72
AUTH_RESET_TTL_HOURS=2
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=example.com
