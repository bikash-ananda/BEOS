generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  city                 String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  departments          Department[]
  users                User[]
  accounts             Account[]
  invoices             Invoice[]
  expenses             Expense[]
  employees            Employee[]
  devices              Device[]
  invitations          Invitation[]
  workspaceAttachments WorkspaceAttachment[]
}

model Department {
  id                   String                @id @default(cuid())
  name                 String
  code                 String
  branchId             String
  branch               Branch                @relation(fields: [branchId], references: [id])
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  users                User[]
  employees            Employee[]
  invitations          Invitation[]
  workspaceAttachments WorkspaceAttachment[]

  @@unique([branchId, code])
}

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  passwordHash          String
  fullName              String
  isActive              Boolean         @default(true)
  branchId              String?
  branch                Branch?         @relation(fields: [branchId], references: [id])
  departmentId          String?
  department            Department?     @relation(fields: [departmentId], references: [id])
  lastLoginAt           DateTime?
  passwordChangedAt     DateTime        @default(now())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  roles                 UserRole[]
  auditLogs             AuditLog[]
  sessions              AuthSession[]
  invitationsSent       Invitation[]    @relation("InvitationCreator")
  passwordResets        PasswordReset[] @relation("PasswordResetUser")
  passwordResetsCreated PasswordReset[] @relation("PasswordResetCreator")
  notifications         Notification[]
  uploadedFiles         FileRecord[]    @relation("FileUploader")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
  invitations InvitationRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  href      String?
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

enum WorkspaceFileScope {
  COMPANY
  BRANCH
  DEPARTMENT
}

model FileRecord {
  id                   String                @id @default(cuid())
  originalName         String
  storageKey           String                @unique
  mimeType             String
  sizeBytes            Int
  sha256               String
  uploadedById         String
  uploadedBy           User                  @relation("FileUploader", fields: [uploadedById], references: [id])
  createdAt            DateTime              @default(now())
  workspaceAttachments WorkspaceAttachment[]

  @@index([uploadedById, createdAt])
  @@index([createdAt])
}

model WorkspaceAttachment {
  id           String             @id @default(cuid())
  fileId       String             @unique
  file         FileRecord         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  scope        WorkspaceFileScope
  branchId     String?
  branch       Branch?            @relation(fields: [branchId], references: [id])
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  createdAt    DateTime           @default(now())

  @@index([scope, createdAt])
  @@index([branchId, createdAt])
  @@index([departmentId, createdAt])
}

model Invitation {
  id           String           @id @default(cuid())
  email        String
  tokenHash    String           @unique
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id])
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  invitedById  String
  invitedBy    User             @relation("InvitationCreator", fields: [invitedById], references: [id])
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  roles        InvitationRole[]

  @@index([email, expiresAt])
  @@index([invitedById])
}

model InvitationRole {
  invitationId String
  roleId       String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([invitationId, roleId])
}

model AuthSession {
  id        String    @id @default(cuid())
  familyId  String
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@index([userId, revokedAt])
}

model PasswordReset {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("PasswordResetCreator", fields: [createdById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([createdById])
}

// ===== PHASE 2: ACCOUNTING =====
model Account {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  type        String // Asset, Liability, Equity, Revenue, Expense
  balance     Decimal   @default(0)
  isActive    Boolean   @default(true)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  entries     GLEntry[]
  invoices    Invoice[]
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  customerId  String?
  amount      Decimal
  amountPaid  Decimal       @default(0)
  status      String // Draft, Issued, Paid, Overdue, Cancelled
  issueDate   DateTime
  dueDate     DateTime
  description String?
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payments    Payment[]
  items       InvoiceItem[]
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemName  String
  quantity  Int
  unitPrice Decimal
  total     Decimal
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Decimal
  paymentDate   DateTime
  paymentMethod String // Cash, Check, Bank, Online
  referenceNo   String?
  notes         String?
  createdAt     DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  expenseNo   String   @unique
  description String
  amount      Decimal
  category    String // Travel, Office, Equipment, etc.
  status      String // Pending, Approved, Rejected, Paid
  claimedBy   String
  approvedBy  String?
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GLEntry {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  debit     Decimal  @default(0)
  credit    Decimal  @default(0)
  reference String?
  note      String?
  createdAt DateTime @default(now())
}

// ===== PHASE 3: PAYROLL =====
model Employee {
  id           String         @id @default(cuid())
  empNo        String         @unique
  firstName    String
  lastName     String
  email        String         @unique
  phone        String?
  dateOfBirth  DateTime?
  joinDate     DateTime
  status       String // Active, OnLeave, Terminated
  position     String
  salary       Decimal
  salaryType   String // Monthly, Hourly, Contract
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id])
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  payslips     Payslip[]
  deductions   Deduction[]
  leaves       LeaveRequest[]
}

model Payslip {
  id             String             @id @default(cuid())
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id])
  month          Int // 1-12
  year           Int
  baseSalary     Decimal
  totalAllowance Decimal
  totalDeduction Decimal
  netSalary      Decimal
  status         String // Draft, Finalized, Paid
  paymentDate    DateTime?
  createdAt      DateTime           @default(now())
  deductions     PayslipDeduction[]

  @@unique([employeeId, month, year])
}

model PayslipDeduction {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  type      String // Tax, Insurance, Pension, Other
  amount    Decimal
}

model Deduction {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String // Tax, Insurance, Pension, Other
  amount     Decimal
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String // Annual, Sick, Personal, Unpaid
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  status     String // Pending, Approved, Rejected
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ===== PHASE 4: INVENTORY =====
model Product {
  id           String          @id @default(cuid())
  sku          String          @unique
  name         String
  description  String?
  category     String
  unitPrice    Decimal
  costPrice    Decimal
  reorderLevel Int             @default(10)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  stocks       Stock[]
  movements    StockMovement[]
}

model Warehouse {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  location String
  capacity Int
  isActive Boolean @default(true)
  stocks   Stock[]
}

model Stock {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  quantity        Int
  lastRestockDate DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String // Inbound, Outbound, Adjustment
  quantity  Int
  reference String? // PO, SO, Inventory ID
  notes     String?
  createdAt DateTime @default(now())
}

// ===== PHASE 5: E-COMMERCE =====
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  city      String?
  country   String?
  status    String // Active, Inactive, Blocked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id            String         @id @default(cuid())
  orderNo       String         @unique
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  totalAmount   Decimal
  taxAmount     Decimal
  shippingCost  Decimal
  status        String // Pending, Confirmed, Shipped, Delivered, Cancelled
  paymentStatus String // Unpaid, Partial, Paid
  orderDate     DateTime       @default(now())
  shippedDate   DateTime?
  deliveredDate DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         OrderItem[]
  payments      OrderPayment[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku       String
  quantity  Int
  unitPrice Decimal
  total     Decimal
}

model OrderPayment {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal
  method    String // Card, Bank, Cash, Online
  status    String // Pending, Confirmed, Failed, Refunded
  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

// ===== PHASE 6: AI AGENTS =====
model AIAgent {
  id          String   @id @default(cuid())
  name        String
  description String?
  model       String // gpt-4, claude, etc.
  status      String // Active, Inactive, Training
  purpose     String? // Accounting, Sales, Support, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       AITask[]
}

model AITask {
  id            String           @id @default(cuid())
  agentId       String
  agent         AIAgent          @relation(fields: [agentId], references: [id])
  title         String
  description   String?
  status        String // Pending, Running, Completed, Failed
  result        String?
  createdAt     DateTime         @default(now())
  completedAt   DateTime?
  conversations AIConversation[]
}

model AIConversation {
  id        String   @id @default(cuid())
  taskId    String
  task      AITask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role      String // user, assistant
  content   String
  tokens    Int?
  createdAt DateTime @default(now())
}

// ===== PHASE 7: IOT =====
model Device {
  id         String        @id @default(cuid())
  deviceId   String        @unique
  name       String
  type       String // Sensor, Controller, Gateway, etc.
  status     String // Online, Offline, Error, Maintenance
  location   String?
  branchId   String
  branch     Branch        @relation(fields: [branchId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  sensors    Sensor[]
  dataPoints DataPoint[]
  alerts     DeviceAlert[]
}

model Sensor {
  id         String      @id @default(cuid())
  deviceId   String
  device     Device      @relation(fields: [deviceId], references: [id])
  name       String
  type       String // Temperature, Humidity, Pressure, Motion, etc.
  unit       String // Celsius, %, Pa, etc.
  minValue   Decimal?
  maxValue   Decimal?
  dataPoints DataPoint[]
}

model DataPoint {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  sensorId  String
  sensor    Sensor   @relation(fields: [sensorId], references: [id])
  value     Decimal
  timestamp DateTime
  createdAt DateTime @default(now())
}

model DeviceAlert {
  id         String    @id @default(cuid())
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id])
  type       String // Warning, Critical, Info
  message    String
  status     String // Active, Acknowledged, Resolved
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}
